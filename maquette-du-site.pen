                          "fontFamily": "$font-ui",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "HpgSr",
                          "name": "Paragraphe",
                          "fill": "$ink-700",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Nous installons chez des cabinets comme le vôtre un agent qui source les entreprises correspondant à votre cible et prépare les emails de premier contact. Vous validez, vous n'écrivez plus.",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-ui",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        },
