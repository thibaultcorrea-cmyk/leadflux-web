                        },
                        {
                          "type": "text",
                          "id": "dZgsM",
                          "name": "Paragraphe",
                          "fill": "$ink-700",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "J'ai vu qu'Aubert Stratégie accompagne des dirigeants de PME sur la transformation depuis plusieurs années, avec une équipe de cinq personnes.",
