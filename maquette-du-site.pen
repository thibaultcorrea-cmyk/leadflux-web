                          "fontFamily": "$font-ui",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "D9wPhP",
                          "name": "Paragraphe",
                          "fill": "$ink-700",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "À cette taille, la prospection retombe presque toujours sur le dirigeant, entre deux missions client. C'est le premier poste qui saute quand le carnet se remplit.",
