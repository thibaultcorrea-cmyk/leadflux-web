# Copier ce fichier en .env.local et renseigner les valeurs reelles.
# .env.local ne doit jamais etre commite (voir .gitignore).

# PostgreSQL (docker-compose.yml en local)
DATABASE_URL=postgresql://leadflux:leadflux@localhost:5432/leadflux

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app
ADMIN_EMAIL="YOUR_EMAIL_ADDRESS"
ADMIN_PASSWORD="YOUR-PASSWORD-HERE"
ADMIN_NAME="YOUR NAME"
ADMIN_IMAGE_URL=""

# Envoi SMTP applicatif. En local, pointe sur le service maildev de
# docker-compose.yml : catch-all (une seule UI web, quel que soit le
# destinataire), sans authentification, donc SMTP_USER/SMTP_PASS ne sont
# pas verifies par maildev (garder des valeurs coherentes pour SMTP_FROM).
# UI de consultation : http://localhost:1080
# En production, remplacer par les identifiants du vrai serveur SMTP
# (jamais commiter ces valeurs reelles).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=leadflux
SMTP_PASS=leadflux
SMTP_FROM=contact@leadflux.local
SMTP_FROM_ALIAS=LeadFlux

# Boite IMAP/SMTP de test (service greenmail de docker-compose.yml), reservee
# a la preuve de detection de reponse par IMAP
# (features/smtp/tests/imap-reply-detection.e2e.ts). Distincte de maildev :
# greenmail simule un vrai compte avec boite IMAP, maildev non. Valeurs par
# defaut deja alignees avec le docker-compose (c'est ce couple qui configure
# le seul compte que greenmail connait), a ne changer que si les
# ports/identifiants du service sont modifies.
IMAP_TEST_HOST=localhost
IMAP_TEST_PORT=3143
IMAP_TEST_USER=test@leadflux.local
IMAP_TEST_PASS=test
